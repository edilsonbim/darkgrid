{
  "name": "darkgrid",
  "version": "0.1.0",
  "description": "Central de contas e farm para o DarkGrid",
  "author": "DarkGrid Team",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis portable",
    "auth:dev": "node tools/dev-auth-server.js"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.darkgrid.app",
    "productName": "DarkGrid",
    "asar": true,
    "files": ["src/**/*", "package.json", "README.md", "LICENSE.md", "THIRD-PARTY-NOTICES.md", "docs/**/*"],
    "directories": { "output": "release" },
    "win": { "target": ["nsis", "portable"], "icon": "src/renderer/assets/darkgrid-pokeball.png", "artifactName": "DarkGrid-${version}-${arch}.${ext}" },
    "nsis": { "artifactName": "DarkGrid-${version}-setup-${arch}.${ext}", "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true },
    "portable": { "artifactName": "DarkGrid-${version}-portable-${arch}.${ext}" }
  }
}
